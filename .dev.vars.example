# 复制为 .dev.vars（已 gitignore）后填写。本地 `next dev` 与 wrangler 都会读取。
# 不填 Stripe key 时，支付按钮在开发环境直接解锁（DEV_UNLOCK）。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe 后台 "WhatHeThinks Full Report" 的价格 ID（price_…）；留空则按 src/lib/pricing.ts 临时定价
STRIPE_PRICE_ID=
RESEND_API_KEY=
EMAIL_FROM="WhatHeThinks <reports@whathethinks.com>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional when using the managed Turnstile Spin verification Worker.
TURNSTILE_VERIFY_URL=
DEV_UNLOCK=1
# 智谱 GLM 的 key：报告先用 DeepSeek 写，失败再用 GLM
FALLBACK_API_KEY=
DEEPSEEK_API_KEY=
# Non-secret model setting is in wrangler.jsonc. Reports are always written in English.

# 本地覆盖 wrangler.jsonc 里的生产域名
SITE_URL=http://localhost:3000
