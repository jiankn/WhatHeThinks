{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whathethinks",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // Preserve dashboard-managed variables that are not declared below.
  "keep_vars": true,
  "routes": [
    { "pattern": "whathethinks.com/*", "zone_name": "whathethinks.com" },
    { "pattern": "www.whathethinks.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whathethinks",
      // 部署前用 `npx wrangler d1 create whathethinks` 创建，把返回的 id 填到这里。
      "database_id": "e3299a4a-cbe2-45d0-8d07-fa53bb3f7492",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://whathethinks.com",
    "GOOGLE_CLIENT_ID": "810001412993-r1qeqgt9klps7059ic6btirlnf4ql0u4.apps.googleusercontent.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFAGYxW9wYYM6md9",
    // 写报告：先 DEEPSEEK_MODEL，失败再用 GLM_MODEL（key 在 FALLBACK_API_KEY）
    "GLM_MODEL": "glm-5.3-flashx",
    "DEEPSEEK_MODEL": "deepseek-flash",
    // Stripe 测试模式价格（WhatHeThinks 沙盒）；转正式收款时换成 live price
    "STRIPE_PRICE_ID": "price_1UIeNtInIVPJpCcmSfeOuIVg"
  }
}
